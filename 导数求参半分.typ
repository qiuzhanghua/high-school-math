      // 割线（过 (0,0) 与 (pi/2, e^{pi/2})）与原点切线
      #seg((60pt, 150pt), (217pt, 5.7pt))
      #seg((60pt, 150pt), (217pt, 102.9pt))
      // pi/2 处虚线
      #seg((217pt, 150pt), (217pt, 5.7pt), stroke: (paint: black, thickness: 0.8pt, dash: "dashed"))
      #dot((60pt, 150pt))
      #dot((217pt, 5.7pt))
      // 标注
      #place(dx: 46pt, dy: 153pt)[$O$]
      #place(dx: 208pt, dy: 153pt)[$pi/2$]
      #place(dx: 146pt, dy: 12pt)[$(pi/2, e^(pi/2))$]
      #place(dx: 92pt, dy: 24pt)[$y = e^x sin x$]
      #place(dx: 132pt, dy: 62pt)[$y = -m x$]
